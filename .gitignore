# Quitar contenido en input/ (excepto el .keep para mantener la carpeta en el repositorio)
input/*
!input/.keep


# Archivos de variables de entorno y directorios de configuración
.env
temp/
!temp/.keep

# Archivos y directorios comunes de R y RStudio
.Rhistory
.RData
.Ruserdata
.Rapp.history
.Rproj.user/

# Archivos y directorios generados por Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
pip-wheel-metadata/
pip-log.txt
pytestdebug.log
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
.hypothesis/
celerybeat-schedule
celerybeat.pid

# Entornos virtuales de Python
.venv/
venv/
env/
ENV/
.envrc

# Distribución y empaquetado de Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Archivos generados por IDEs y herramientas
.idea/
.vscode/

# ==========================================
# LaTeX Temporary & Auxiliary Files (Inside docs/)
# ==========================================

# Core auxiliary files
docs/**/*.aux
docs/**/*.log
docs/**/*.fls
docs/**/*.fdb_latexmk
docs/**/*.synctex.gz

# Table of contents, figures, and tables lists
docs/**/*.toc
docs/**/*.lof
docs/**/*.lot

# Bibliography files (BibTeX / Biber)
docs/**/*.bbl
docs/**/*.blg
docs/**/*.bcf
docs/**/*.run.xml

# Hyperref and outlines
docs/**/*.out
docs/**/*.out.ps

# Indexes and Glossaries
docs/**/*.idx
docs/**/*.ind
docs/**/*.ilg
docs/**/*.glo
docs/**/*.gls
docs/**/*.glg

# Document-specific build folders (if using Strategy 1)
docs/out/
docs/build/